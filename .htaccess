# ----------------------------------------------------------------------
# BLINDAGEM DO CLOAKER
# ----------------------------------------------------------------------
# Sem isto, quem digita o nome do ficheiro recebe a página sem passar pelo
# portão: /vendas.html entregava a VSL preta a qualquer revisor ou crawler.
# A regra lê THE_REQUEST, que é a linha crua do pedido, por isso só apanha
# quem veio de fora — o include do index.php e os rewrites internos passam.
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# vendas.html e clean.html, em qualquer pasta, voltam para a pasta
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+(.*/)?(vendas|clean)\.html [NC]
RewriteRule ^(.*/)?(vendas|clean)\.html$ /$1 [R=301,L]

# index.html da RAIZ volta para a raiz (o cloaker é o index.php).
# Nas subpastas o index.html é a própria página, com portão por JS — fica.
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+index\.html [NC]
RewriteRule ^index\.html$ / [R=301,L]
</IfModule>

# ----------------------------------------------------------------------
# FORÇAR ENCODING UTF-8 GLOBAL (CORRIGE QUALQUER ERRO DE ACENTUAÇÃO)
# ----------------------------------------------------------------------
AddDefaultCharset UTF-8
AddCharset UTF-8 .html .php .css .js .txt .json .xml

<IfModule mod_mime.c>
  AddType "text/html; charset=UTF-8" .html .htm
  AddType "text/css; charset=UTF-8" .css
  AddType "application/javascript; charset=UTF-8" .js
</IfModule>

# ----------------------------------------------------------------------
# OTIMIZAÇÃO DE VELOCIDADE ULTRA-RÁPIDA (CAMINHOS DA FÉ)
# ----------------------------------------------------------------------

# 1. COMPRESSÃO GZIP / DEFLATE
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json application/xml image/svg+xml
</IfModule>

# 2. CACHE DE NAVEGADOR (EXPIRES HEADERS)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # Imagens e ícones: 1 ano
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # Fontes: 1 ano
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"

  # CSS e JavaScript: 1 mês
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"

  # HTML: Sem cache longo para atualizar na hora
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# 3. CABEÇALHOS DE SEGURANÇA E CACHE
<IfModule mod_headers.c>
  Header set Connection keep-alive
  <FilesMatch "\.(ico|jpg|jpeg|png|gif|webp|svg|woff|woff2|ttf)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "max-age=2592000, public"
  </FilesMatch>
  <FilesMatch "\.(html|php)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>
