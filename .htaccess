# ----------------------------------------------------------------------
# FORÇAR ENCODING UTF-8 GLOBAL (CORRIGE QUALQUER ERRO DE ACENTUAÇÃO)
# ----------------------------------------------------------------------
AddDefaultCharset UTF-8
AddCharset UTF-8 .html .php .css .js .txt .json .xml

<IfModule mod_mime.c>
  AddType "text/html; charset=UTF-8" .html .htm
  AddType "text/css; charset=UTF-8" .css
  AddType "application/javascript; charset=UTF-8" .js
</IfModule>

# ----------------------------------------------------------------------
# OTIMIZAÇÃO DE VELOCIDADE ULTRA-RÁPIDA (CAMINHOS DA FÉ)
# ----------------------------------------------------------------------

# 1. COMPRESSÃO GZIP / DEFLATE
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json application/xml image/svg+xml
</IfModule>

# 2. CACHE DE NAVEGADOR (EXPIRES HEADERS)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # Imagens e ícones: 1 ano
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # Fontes: 1 ano
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"

  # CSS e JavaScript: 1 mês
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"

  # HTML: Sem cache longo para atualizar na hora
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# 3. CABEÇALHOS DE SEGURANÇA E CACHE
<IfModule mod_headers.c>
  Header set Connection keep-alive
  <FilesMatch "\.(ico|jpg|jpeg|png|gif|webp|svg|woff|woff2|ttf)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "max-age=2592000, public"
  </FilesMatch>
  <FilesMatch "\.(html|php)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>
